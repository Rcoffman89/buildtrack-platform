# Copy to .env. VITE_ vars are safe to expose client-side (Supabase anon/publishable key is
# meant to be public — RLS policies are what actually enforce access, not this key).

VITE_SUPABASE_URL=https://pluabugihcikggvaeclo.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by scripts/invite-user.mjs, never bundled into client code. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
